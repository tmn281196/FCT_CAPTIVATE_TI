<UserControl x:Class="Touch_Panel.View.TunningPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Touch_Panel.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
      >

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- MergedDictionaries phải đặt TRÊN CÙNG -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Template.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sau đó mới đặt các resource -->
            <local:CountToOrientationConverter x:Key="CountToOrientationConverter"/>
            <local:IndexToTesterConverter x:Key="IdxToTester"/>

            <!-- Style chung cho các nút nhỏ trong trang: bo góc, xanh nhạt, hover xanh -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="#EAF1F8"/>
                <Setter Property="Foreground" Value="#1B2A38"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0 2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#C3D3EE" BorderThickness="1" Padding="4,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1B75BB"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#155E96"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab MICOM1/MICOM2: bo góc, tab đang chọn = xanh #1B75BB -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#44505C"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="bd" Background="#EAF1F8" BorderBrush="#C3D3EE" BorderThickness="1" CornerRadius="6,6,0,0" Margin="2,0,0,0" Padding="22,8">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#D6E4F5"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1B75BB"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusLabelStyle" TargetType="Label">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Wait">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="Orange" />
                        <Setter Property="Content" Value="WAIT" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="#347474" />
                        <Setter Property="Content" Value="READY" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Testing">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="#f8da5b" />
                        <Setter Property="Content" Value="TESTING" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Pass">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="LimeGreen" />
                        <Setter Property="Content" Value="PASS" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="Red" />
                        <Setter Property="Content" Value="FAIL" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

      
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       


        <TabControl x:Name="MicomTabs">
            <TabItem Header="MICOM1">
                <Grid   >
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                   

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Column="0" >
                        <ItemsControl ItemsSource="{Binding AllCAPElementsMicom1}"  >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#F0F0F0"      BorderThickness="1">
                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding StringId }" FontWeight="Bold" FontSize="14" Foreground="White" Background="#1B75BB" TextAlignment="Center" Padding="0,3"/>

                                            <DataGrid Grid.Row="1" FontSize="13" IsReadOnly="True"     ItemsSource="{Binding ListTunningParameter}" Background="White" Style="{StaticResource CustomDataGridStyle}"
ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding OffsetTap}" Width="60" Header="O" />
                                                    <DataGridTextColumn Binding="{Binding FineGainRatio}" Width="60"  Header="F" />
                                                    <DataGridTextColumn Binding="{Binding CoarseGainRatio}" Width="60"  Header="C" />
                                                    <DataGridTextColumn Binding="{Binding Lta}" Width="60"  Header="LTA" />

                                                </DataGrid.Columns>


                                            </DataGrid>

                                            <StackPanel Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" >
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedOffsetTap }" TextAlignment="Center" FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedFineGainRatio }" TextAlignment="Center"  FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedCoarseGainRatio }" TextAlignment="Center"  FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedLta }" TextAlignment="Center"  FontSize="13" Background="Orange"/>

                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" >
                                                    <TextBox  Width="60" Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13" Text="{Binding OffsetTap }" TextAlignment="Center"/>
                                                    <TextBox  Width="60" Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding FineGainRatio }" TextAlignment="Center"/>
                                                    <TextBox  Width="60" Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding CoarseGainRatio }" TextAlignment="Center"/>
                                                    <TextBox  Width="60" Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding Lta }" TextAlignment="Center"/>

                                                </StackPanel>
                                             
                                              
                                            </StackPanel>


                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                </Grid>



            </TabItem>
            <TabItem Header="MICOM2">
                <Grid   >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Column="0" >
                        <ItemsControl ItemsSource="{Binding AllCAPElementsMicom2}"  >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#F0F0F0"      BorderThickness="1">
                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding StringId}" FontWeight="Bold" FontSize="14" Foreground="White" Background="#1B75BB" TextAlignment="Center" Padding="0,3"/>

                                            <DataGrid Grid.Row="1" FontSize="13" IsReadOnly="True"     ItemsSource="{Binding ListTunningParameter}" Background="White" Style="{StaticResource CustomDataGridStyle}"
ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding OffsetTap}" Width="60" Header="O" />
                                                    <DataGridTextColumn Binding="{Binding FineGainRatio}" Width="60"  Header="F" />
                                                    <DataGridTextColumn Binding="{Binding CoarseGainRatio}" Width="60"  Header="C" />
                                                    <DataGridTextColumn Binding="{Binding Lta}" Width="60"  Header="LTA" />

                                                </DataGrid.Columns>


                                            </DataGrid>

                                            <StackPanel Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" >
                                                    <TextBox  Width="60" IsReadOnly="True" Text="{Binding  CalculatedOffsetTap }" TextAlignment="Center" FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedFineGainRatio }" TextAlignment="Center"  FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedCoarseGainRatio }" TextAlignment="Center"  FontSize="13" Background="Orange"/>
                                                    <TextBox  Width="60" IsReadOnly="True"  Text="{Binding CalculatedLta }" TextAlignment="Center"  FontSize="13" Background="Orange"/>

                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" >
                                                    <TextBox  Width="60"  Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding OffsetTap }" TextAlignment="Center"/>
                                                    <TextBox  Width="60"  Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding FineGainRatio }" TextAlignment="Center"/>
                                                    <TextBox  Width="60"  Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding CoarseGainRatio }" TextAlignment="Center"/>
                                                    <TextBox  Width="60"  Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="13"  Text="{Binding Lta }" TextAlignment="Center"/>

                                                </StackPanel>


                                            </StackPanel>


                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                </Grid>



            </TabItem>
        </TabControl>

        <Grid Margin="5 5"  Grid.Row="1" HorizontalAlignment="Stretch"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Command="{Binding SaveModelCommand}" Cursor="Hand" HorizontalAlignment="Left" Height="36" ToolTip="Save tuning to database">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1B75BB" CornerRadius="5" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconBlock Icon="Database" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="SAVE" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#155E96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Margin="10 0 0 0">
                <StackPanel Orientation="Horizontal">
                    <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Padding="5 0" Height="18" Margin="5 0" FontSize="11" FontWeight="Bold"  Content="Notation:"/>
                    <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Padding="5 0" Height="18" Margin="5 0" FontSize="11" Background="Orange" FontWeight="SemiBold" Content="Median Value"/>
                    <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Padding="5 0" Height="18" Margin="5 0" Background="#1B75BB" Foreground="White" FontWeight="SemiBold" FontSize="11" Content="Staged Value"/>
                </StackPanel>
            </StackPanel>

            <!-- Bộ điều khiển CHUNG: trỏ tới tester của tab đang chọn (MICOM1/MICOM2) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2">

                <!-- MICOM -->
                <Label Content="Micom" FontWeight="Bold" VerticalAlignment="Center" Padding="4 0"/>
                <Button ToolTip="Halt MICOM" Cursor="Hand" FontSize="12" Width="52" Height="26" Margin="1 0" Content="HALT"
                        Command="{Binding DisableMICOMCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>
                <Button ToolTip="Resume MICOM" Cursor="Hand" FontSize="12" Width="60" Height="26" Margin="1 0" Content="RESUME"
                        Command="{Binding EnableMICOMCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>
                <Button ToolTip="Calibrate MICOM" Cursor="Hand" FontSize="12" Width="52" Height="26" Margin="1 0" Content="CALIB"
                        Command="{Binding ResetMICOMCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>

                <Border Width="1" Background="#C3D3EE" Margin="8 3"/>

                <!-- RAM -->
                <Label Content="RAM" FontWeight="Bold" VerticalAlignment="Center" Padding="4 0"/>
                <Button ToolTip="Load values from MICOM RAM" Cursor="Hand" FontSize="12" Width="52" Height="26" Margin="1 0" Content="LOAD"
                        Command="{Binding GetAllTunningCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>
                <Button ToolTip="Store values to MICOM RAM" Cursor="Hand" FontSize="12" Width="52" Height="26" Margin="1 0" Content="STORE"
                        Command="{Binding SetAllTunningCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>

                <Border Width="1" Background="#C3D3EE" Margin="8 3"/>

                <!-- List / tuning ops -->
                <Button ToolTip="Clear tuning list" Cursor="Hand" Width="34" Height="26" Margin="1 0"
                        Command="{Binding ResetTunningListCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}">
                    <fa:IconImage Icon="Remove" Foreground="Black" Height="14"/>
                </Button>
                <Button ToolTip="Add a sample" Cursor="Hand" Width="34" Height="26" Margin="1 0"
                        Command="{Binding AddToTunningListCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}">
                    <fa:IconImage Icon="PlusCircle" Foreground="Black" Height="16"/>
                </Button>
                <Button ToolTip="Remove last sample" Cursor="Hand" Width="34" Height="26" Margin="1 0"
                        Command="{Binding RemoveTheLastFromTunningListCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}">
                    <fa:IconImage Icon="MinusCircle" Foreground="Black" Height="16"/>
                </Button>
                <Button ToolTip="Compute median" Cursor="Hand" FontSize="12" Width="60" Height="26" Margin="1 0" Content="MEDIAN"
                        Command="{Binding CalculateTunningCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>
                <Button ToolTip="Stage computed values" Cursor="Hand" FontSize="12" Width="52" Height="26" Margin="1 0" Content="STAGE"
                        Command="{Binding SetBackCalculatedTunningToCacheCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}"/>

                <Border Width="1" Background="#C3D3EE" Margin="8 3"/>

                <!-- Actuator (icon đồng bộ với trang Manual) -->
                <Label Content="Actuator" FontWeight="Bold" VerticalAlignment="Center" Padding="4 0"/>
                <Button ToolTip="Reset" Cursor="Hand" Width="46" Height="26" Margin="1 0"
                        Command="{Binding ResetCommand}" CommandParameter="{Binding SelectedIndex, ElementName=MicomTabs, Converter={StaticResource IdxToTester}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ArrowUp" Foreground="Black" Width="14"/>
                        <fa:IconImage Icon="MapPin" Foreground="Black" Width="9"/>
                    </StackPanel>
                </Button>
                <Button ToolTip="Connector Up" Cursor="Hand" Width="48" Height="26" Margin="1 0" Command="{Binding ConnectorAllUpCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ArrowUp" Foreground="Black" Width="10"/>
                        <fa:IconImage Icon="ArrowUp" Foreground="Black" Width="10"/>
                        <fa:IconImage Icon="ArrowUp" Foreground="Black" Width="10"/>
                    </StackPanel>
                </Button>
                <Button ToolTip="Connector Down" Cursor="Hand" Width="48" Height="26" Margin="1 0" Command="{Binding ConnectorAllDownCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ArrowDown" Foreground="Black" Width="10"/>
                        <fa:IconImage Icon="ArrowDown" Foreground="Black" Width="10"/>
                        <fa:IconImage Icon="ArrowDown" Foreground="Black" Width="10"/>
                    </StackPanel>
                </Button>
                <Button ToolTip="Reset Fixture" Cursor="Hand" Width="48" Height="26" Margin="1 0" Command="{Binding ResetCylinderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="ArrowUpWideShort" Foreground="Black" Width="16" RenderTransformOrigin="0.5,0.5">
                            <fa:IconImage.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </fa:IconImage.RenderTransform>
                        </fa:IconImage>
                        <fa:IconImage Icon="ArrowUpWideShort" Foreground="Black" Width="16"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>


    </Grid>
</UserControl>

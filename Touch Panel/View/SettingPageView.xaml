<UserControl x:Class="Touch_Panel.View.SettingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View"
             xmlns:conv="clr-namespace:Touch_Panel.Converters">
    <UserControl.Resources>
        <conv:MultiValueJoinConverter x:Key="PipeJoinConverter" Separator="|"/>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="DeletableOptionTemplate">
            <DockPanel LastChildFill="True" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18" Padding="0" Margin="8 0 0 0"
                        FontSize="10" Foreground="Red" Cursor="Hand" Style="{x:Null}"
                        ToolTip="Delete this option"
                        Command="{Binding DataContext.DeleteOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource PipeJoinConverter}">
                            <Binding RelativeSource="{RelativeSource AncestorType=ComboBox}" Path="Tag"/>
                            <Binding/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <!-- Style chung cho các nút trong trang Setting: bo góc, xanh nhạt, hover xanh -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#EAF1F8"/>
            <Setter Property="Foreground" Value="#1B2A38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#C3D3EE" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B75BB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#155E96"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút icon xám bo tròn kiểu ZeroC (connect-all / disconnect-all / refresh) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E6EA"/>
            <Setter Property="Foreground" Value="#44505C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#C2CAD2" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D2D8DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C2CAD2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical"  Grid.ColumnSpan="2" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
                <Label Padding="0" HorizontalAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Content="Log Directory" Width="100" FontWeight="Bold"/>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox   Text="{Binding Model.Settings.LogDir, Mode=OneWay}" IsReadOnly="True" x:Name="mesDirTxtBox" Width="500" Padding="0 2" VerticalAlignment="Center" />
                    <Button x:Name="changeMesDirBtn" Command="{Binding ChangeToNewLogDirCommand}" BorderThickness="0"  Width="30" Height="30" Background="Transparent" Cursor="Hand" ToolTip="Change log directory">
                        <fa:IconBlock Icon="FolderOpen" FontSize="18" Foreground="#E0A100"/>
                    </Button>
                </StackPanel>

            </StackPanel>



            <Separator/>


            <Grid >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                 
                </Grid.ColumnDefinitions>


                <StackPanel IsEnabled="{Binding AutoState.IsNotBusy}">
                    <StackPanel Margin="5">
                        <Label Padding="0" Content="Communication" FontWeight="Bold"  />

                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="Micom 1" Width="70"/>
                            <ComboBox  HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.MicomCom1Port}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="Micom1"
                                        Visibility="{Binding Model.Devices.DevicesStatus[2].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="Micom1"
                                        Visibility="{Binding Model.Devices.DevicesStatus[2].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="Micom 2" Width="70"/>
                            <ComboBox HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.MicomCom2Port}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="Micom2"
                                        Visibility="{Binding Model.Devices.DevicesStatus[3].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="Micom2"
                                        Visibility="{Binding Model.Devices.DevicesStatus[3].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="System" Width="70"/>
                            <ComboBox  HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.SystemComPort}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="System"
                                        Visibility="{Binding Model.Devices.DevicesStatus[0].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="System"
                                        Visibility="{Binding Model.Devices.DevicesStatus[0].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="Solenoid 1" Width="70"/>
                            <ComboBox HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.Solenoid1ComPort}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="Solenoid 1"
                                        Visibility="{Binding Model.Devices.DevicesStatus[4].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="Solenoid 1"
                                        Visibility="{Binding Model.Devices.DevicesStatus[4].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="Solenoid 2" Width="70"/>
                            <ComboBox HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.Solenoid2ComPort}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="Solenoid 2"
                                        Visibility="{Binding Model.Devices.DevicesStatus[5].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="Solenoid 2"
                                        Visibility="{Binding Model.Devices.DevicesStatus[5].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="Solenoid 3" Width="70"/>
                            <ComboBox HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.Solenoid3ComPort}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="Solenoid 3"
                                        Visibility="{Binding Model.Devices.DevicesStatus[1].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="Solenoid 3"
                                        Visibility="{Binding Model.Devices.DevicesStatus[1].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                        </StackPanel>
                        <StackPanel Margin="0 5" Orientation="Horizontal">
                            <Label Content="QR Printer" Width="70"/>
                            <ComboBox HorizontalContentAlignment="Left" SelectedItem="{Binding Model.Devices.QrPrinterComPort}" ItemsSource="{Binding Model.Devices.ComPortList}" Width="100"/>
                            <Grid Width="66" Margin="10,0,0,0">
                                <Button Content="OPEN" Background="#2E7D32" Foreground="White" Command="{Binding DeviceConnectCommand}" CommandParameter="QR Printer"
                                        Visibility="{Binding Model.Devices.DevicesStatus[6].Connected, Converter={StaticResource BoolToVis}, ConverterParameter=inv}"/>
                                <Button Content="CLOSE" Background="#C0392B" Foreground="White" Command="{Binding DeviceCloseCommand}" CommandParameter="QR Printer"
                                        Visibility="{Binding Model.Devices.DevicesStatus[6].Connected, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,14">
                        <!-- Toggle Connect/Disconnect All kiểu ZeroC: chưa nối = Plug (nối tất), đang nối = PlugCircleXmark (ngắt tất) -->
                        <ToggleButton x:Name="connectAllToggle" Click="ConnectAllToggle_Click" Width="34" Height="28" Margin="0,0,6,0" Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="ToolTip" Value="Connect All"/>
                                    <Setter Property="Background" Value="#E2E6EA"/>
                                    <Setter Property="Foreground" Value="#44505C"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#C2CAD2" BorderThickness="1" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#D2D8DE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <fa:IconBlock Icon="Plug" FontSize="16" Foreground="#44505C"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="Disconnect All"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <fa:IconBlock Icon="PlugCircleXmark" FontSize="16" Foreground="#44505C"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button Command="{Binding RefreshComportCommand}" Style="{StaticResource IconBtn}" ToolTip="Refresh All COM Ports">
                            <fa:IconBlock Icon="Refresh" FontSize="15" Foreground="#44505C"/>
                        </Button>
                    </StackPanel>

                </StackPanel>

             
            </Grid>
            <Separator/>


            <StackPanel  Grid.Column="1" IsEnabled="{Binding AutoState.IsNotBusy}">
                <StackPanel Margin="5">
                    <Label Padding="0" Content="Test Flow" FontWeight="Bold" />
                    <StackPanel Margin="5 0">
                        <CheckBox  Margin="0 5"  Content="Stop All When Any Failed Step" IsChecked="{Binding Model.Settings.ShouldStopAllWhenAnyFailedStep}"/>
                        <CheckBox  Margin="0 5"  Content="Main Reset When Pass Test" IsChecked="{Binding Model.Settings.ShouldMainResetWhenPassTest}"/>
                        <CheckBox  Margin="0 5"  Content="Main Reset When Fail Test" IsChecked="{Binding Model.Settings.ShouldMainResetWhenFailTest}"/>
                        <CheckBox  Margin="0 5"  Content="Buzzer When Fail Test" IsChecked="{Binding Model.Settings.ShouldBuzzerWhenFailTest}"/>
                        <CheckBox  Margin="0 5"  Content="Save Log File" IsChecked="{Binding Model.Settings.ShouldSaveLog}"/>
                        <CheckBox  Margin="0 5"  Content="Send QR Print" IsChecked="{Binding Model.Settings.ShouldPrintQr}"/>

                        <StackPanel Orientation="Horizontal" Margin="0 8 0 5">
                            <Label Padding="0" Content="Max Margin" VerticalAlignment="Center" Width="90"
                                   ToolTip="Element phải dẫn trước đỉnh nhì ít nhất bằng giá trị này mới coi là max (chống nhảy khi 2 đỉnh gần bằng)."/>
                            <TextBox Width="60" Height="22" VerticalContentAlignment="Center"
                                     Text="{Binding Model.Settings.Margin, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Separator/>

            <StackPanel Margin="5" IsEnabled="{Binding AutoState.IsNotBusy}">
                <Label Padding="0" Content="Product Info" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="5 5">
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" Content="Part Number (10)" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox IsEditable="True" Padding="2 0" Height="25" Width="150" VerticalContentAlignment="Center"
                                  Tag="PartNumber"
                                  ItemTemplate="{StaticResource DeletableOptionTemplate}"
                                  ItemsSource="{Binding Model.UserSelectOptions.PartNumberList}"
                                  Text="{Binding Model.Settings.PartNumber, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" Content="Partner Code (4)" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox IsEditable="True" Padding="2 0" Height="25" Width="70" VerticalContentAlignment="Center"
                                  Tag="PartnerCode"
                                  ItemTemplate="{StaticResource DeletableOptionTemplate}"
                                  ItemsSource="{Binding Model.UserSelectOptions.PartnerCodeList}"
                                  Text="{Binding Model.Settings.PartnerCode, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" Content="Country (2)" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox IsEditable="True" Padding="2 0" Height="25" Width="50" VerticalContentAlignment="Center"
                                  Tag="CountryCode"
                                  ItemTemplate="{StaticResource DeletableOptionTemplate}"
                                  ItemsSource="{Binding Model.UserSelectOptions.CountryCodeList}"
                                  Text="{Binding Model.Settings.CountryCode, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" Content="Line (3)" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox IsEditable="True" Padding="2 0" Height="25" Width="60" VerticalContentAlignment="Center"
                                  Tag="LineCode"
                                  ItemTemplate="{StaticResource DeletableOptionTemplate}"
                                  ItemsSource="{Binding Model.UserSelectOptions.LineCodeList}"
                                  Text="{Binding Model.Settings.LineCode, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Padding="0" Content="Equipment (4)" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox IsEditable="True" Padding="2 0" Height="25" Width="70" VerticalContentAlignment="Center"
                                  Tag="EquipmentSerial"
                                  ItemTemplate="{StaticResource DeletableOptionTemplate}"
                                  ItemsSource="{Binding Model.UserSelectOptions.EquipmentSerialList}"
                                  Text="{Binding Model.Settings.EquipmentSerial, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Separator/>

            <StackPanel Margin="5">
                <Label Padding="0" Content="Firmware" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="5 5">
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" Content="Firmware File" FontWeight="Bold" Margin="0 0 0 3"/>
                        <ComboBox Width="280" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                  ItemsSource="{Binding Model.Devices.FirmwareList}"
                                  SelectedItem="{Binding Model.Devices.SelectedFirmwareMicom, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0 0 15 0">
                        <Label Padding="0" FontWeight="Bold" Margin="0 0 0 3">
                            <Label.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconImage Icon="Microchip" Foreground="Black" Width="15"/>
                                    <TextBlock Padding="2 0" VerticalAlignment="Center">MICOM1</TextBlock>
                                </StackPanel>
                            </Label.Content>
                        </Label>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding WriteFirmwareCommand}" Width="70" Height="25" CommandParameter="1" Cursor="Hand" Content="WRITE" Margin="0 0 4 0" Padding="5 0"/>
                            <Button Command="{Binding VerifyFirmwareCommand}" Width="70" Height="25" CommandParameter="1" Cursor="Hand" Content="VERIFY" Padding="5 0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <Label Padding="0" FontWeight="Bold" Margin="0 0 0 3">
                            <Label.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconImage Icon="Microchip" Foreground="Black" Width="15"/>
                                    <TextBlock Padding="2 0" VerticalAlignment="Center">MICOM2</TextBlock>
                                </StackPanel>
                            </Label.Content>
                        </Label>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding WriteFirmwareCommand}" Width="70" Height="25" CommandParameter="2" Cursor="Hand" Content="WRITE" Margin="0 0 4 0" Padding="5 0"/>
                            <Button Command="{Binding VerifyFirmwareCommand}" Width="70" Height="25" CommandParameter="2" Cursor="Hand" Content="VERIFY" Padding="5 0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Separator/>








            <!--<StackPanel    HorizontalAlignment="Left"   Orientation="Vertical" Margin="5" >
                <Label    HorizontalAlignment="Left" VerticalAlignment="Center" Height="25"  Padding="0" FontWeight="Bold"  >
                    <Label.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <fa:IconImage Icon="LayerGroup" Foreground="Black" Width="15" />
                            <TextBlock   Padding="2 0" VerticalAlignment="Center">MICOM Data Layout</TextBlock>

                        </StackPanel>
                    </Label.Content>
                </Label>

                <StackPanel  HorizontalAlignment="Left"   VerticalAlignment="Center" >
                    <Grid Margin="5 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label VerticalContentAlignment="Center" Padding="0 0 10 0" >Micom 1</Label>
                        <ListView ItemsSource="{Binding Model.Devices.MicomData1.ListCAPSensor}"  Grid.Column="1" Margin="0 0"  BorderBrush="Black"  SelectedItem="{Binding SelectedCAPSensor1}">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ListView ItemsSource="{Binding ListCAPCycle}"  BorderBrush="Gray"   SelectedItem="{Binding DataContext.SelectedCAPCycle1,  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ListView ItemsSource="{Binding ListCAPElement}" BorderBrush="DarkGray" SelectedItem="{Binding DataContext.SelectedCAPElement1, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>

                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding StringId}" FontSize="11" HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>


                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>


                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Grid.Column="2" >
                            <StackPanel Orientation="Vertical" Margin="2 0">
                                <Button Width="100" Margin="0 0 0 2" Content="Add Sensor"   Command="{Binding AddSensorCommand}" CommandParameter="1"/>
                                <Button Width="100" Margin="0 0 0 2" Content="Add Cycle"    Command="{Binding AddCycleCommand}"  CommandParameter="1"/>
                                <Button Width="100" Margin="0 0 0 2" Content="Add Element"  Command="{Binding AddElementCommand}"  CommandParameter="1"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="2 0">
                                <Button Width="100" Margin="0 0 0 2" Content="Delete Sensor"  Command="{Binding DeleteSensorCommand}" CommandParameter="1" />
                                <Button Width="100" Margin="0 0 0 2" Content="Delete Cycle"   Command="{Binding DeleteCycleCommand}"  CommandParameter="1" />
                                <Button Width="100" Margin="0 0 0 2" Content="Delete Element" Command="{Binding DeleteElementCommand}"  CommandParameter="1" /> 
                            </StackPanel>
                        </StackPanel>
                    </Grid>





                    <Grid Margin="5 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label VerticalContentAlignment="Center" Padding="0 0 10 0">Micom 2</Label>


                        <ListView ItemsSource="{Binding Model.Devices.MicomData2.ListCAPSensor}"  Grid.Column="1" Margin="0 0"  BorderBrush="Black"  SelectedItem="{Binding SelectedCAPSensor2}">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ListView ItemsSource="{Binding ListCAPCycle}"  BorderBrush="Gray"   SelectedItem="{Binding DataContext.SelectedCAPCycle2,  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ListView ItemsSource="{Binding ListCAPElement}" BorderBrush="DarkGray" SelectedItem="{Binding DataContext.SelectedCAPElement2, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>

                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding StringId}" FontSize="11" HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>


                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>


                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Grid.Column="2" >

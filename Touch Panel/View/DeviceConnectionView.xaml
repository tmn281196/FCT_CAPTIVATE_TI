<UserControl x:Class="Touch_Panel.View.DeviceConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Touch_Panel.View"
             >
    <UserControl.Resources>
        <local:UpperCaseConverter x:Key="Upper"/>
    </UserControl.Resources>
    <Grid Margin="10, 0, 0, 0" Height="15" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="Tx" Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <!-- Đèn báo GỬI: tối lúc rảnh, sáng trắng khi đang gửi -->
                    <Setter Property="Fill" Value="#55636F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TxSent}" Value="True">
                            <Setter Property="Fill" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
        <Rectangle x:Name="Rx" Grid.Row="1" Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <!-- Đèn báo NHẬN: tối lúc rảnh, sáng trắng khi đang nhận -->
                    <Setter Property="Fill" Value="#55636F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RxReceived}" Value="True">
                            <Setter Property="Fill" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
        <!-- Chữ tên: LimeGreen khi kết nối mở, trắng khi đóng -->
        <Label x:Name="lbPortName" Content="{Binding Name, Converter={StaticResource Upper}, UpdateSourceTrigger=PropertyChanged}"
            Grid.RowSpan="2" Grid.Column="1"
            FontSize="11"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Padding="5,0">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Connected}" Value="True">
                            <Setter Property="Foreground" Value="LimeGreen"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </Grid>
</UserControl>

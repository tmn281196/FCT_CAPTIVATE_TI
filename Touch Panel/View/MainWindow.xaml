<Window x:Class="Touch_Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:Touch_Panel"
        xmlns:view="clr-namespace:Touch_Panel.View"
        mc:Ignorable="d"
        Title="TOUCH SENSING TESTER" Height="1080" Width="1920"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Window.Resources>
        <view:BoolToVisConverter x:Key="BoolToVis"/>
        <!-- Nút About: vuông, viền trắng, hover Peru (giống ZeroC) -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Margin" Value="0 3"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="Peru"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút trang (RadioButton): trang đang mở SÁNG #1B75BB, hover Peru (giống ZeroC) -->
        <Style x:Key="NavIconRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0 3"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="Peru"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B75BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút top bar (Open/Save/SaveAs) có icon + chữ, bo góc (giống ZeroC) -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B75BB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#5A6470"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.7*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <StackPanel Background="{StaticResource BaseBrush}" Grid.Row="1">
                <RadioButton Style="{StaticResource NavIconRadio}" IsChecked="True" Command="{Binding HomePageCommand}" ToolTip="AUTO">
                    <fa:IconBlock Icon="Play" FontSize="26" Foreground="White"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavIconRadio}" Command="{Binding ManualPageCommand}" ToolTip="MANUAL">
                    <fa:IconBlock Icon="ComputerMouse" FontSize="24" Foreground="White"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavIconRadio}" Command="{Binding TunningPageCommand}" ToolTip="TUNNING">
                    <fa:IconBlock Icon="Wrench" FontSize="24" Foreground="White"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavIconRadio}" Command="{Binding NewModelPageCommand}" ToolTip="MODEL">
                    <fa:IconBlock Icon="List12" FontSize="26" Foreground="White"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavIconRadio}" Command="{Binding SettingPageCommand}" ToolTip="SETTING">
                    <fa:IconBlock Icon="Cog" FontSize="26" Foreground="White"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavIconRadio}" Command="{Binding LogPageCommand}" ToolTip="LOG">
                    <fa:IconBlock Icon="Terminal" FontSize="24" Foreground="White"/>
                </RadioButton>
                <Button Style="{StaticResource NavIconButton}" Click="AboutBtn_Click" ToolTip="About">
                    <fa:IconBlock Icon="CircleInfo" FontSize="26" Foreground="White"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                <Label Content="TOUCH SENSING TESTER" Background="{StaticResource DarkBarBrush}" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="35"/>

                <!-- TRÁI: HEX FILE + START/STOP -->
                <StackPanel Margin="72,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <fa:IconBlock Icon="FileLines" FontSize="14" Foreground="#CFE0F0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.Devices.SelectedFirmwareMicom}" Foreground="Orange" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,18,0"/>

                    <Button Style="{StaticResource TitleBtn}" Background="#2E7D32" Margin="0" Focusable="False" ToolTip="Start test (chỉ trang AUTO)"
                            Command="{Binding AutoPageVM.ForceStartCommand}"
                            IsEnabled="{Binding AutoPageVM.AutoPageActive}"
                            Visibility="{Binding AutoPageVM.State.IsNotTesting, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Play" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="START" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleBtn}" Background="#D32F2F" Margin="0" Focusable="False" ToolTip="Stop test (chỉ trang AUTO)"
                            Command="{Binding AutoPageVM.ForceStopCommand}"
                            IsEnabled="{Binding AutoPageVM.AutoPageActive}"
                            Visibility="{Binding AutoPageVM.State.IsTesting, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Stop" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="STOP" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Margin="10"  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <fa:IconBlock Icon="FileLines" FontSize="15" Foreground="#CFE0F0" VerticalAlignment="Center"/>
                    <Label Content="{Binding ModelName}" VerticalContentAlignment="Center" Foreground="#CFE0F0" FontStyle="Italic" FontSize="14" Margin="4,0,10,0"/>

                    <Button Command="{Binding OpenModelCommand}" IsEnabled="{Binding AutoState.IsNotBusy}" Style="{StaticResource TitleBtn}" ToolTip="Open Model File">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FolderOpen" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveModelCommand}" IsEnabled="{Binding AutoState.IsNotBusy}" Style="{StaticResource TitleBtn}" Background="#2E7D32" ToolTip="Save Model">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FloppyDisk" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="SAVE" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveModelAsCommand}" IsEnabled="{Binding AutoState.IsNotBusy}" Style="{StaticResource TitleBtn}" Background="#2E7D32" ToolTip="Save Model As">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FileExport" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="SAVE AS" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" />
            <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding DeviceConnectionPage}" />
        </Grid>

    </Grid>
</Window>

<UserControl x:Class="Touch_Panel.View.DeviceConnectionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View">
    <UserControl.Resources>
        <local:FirstNonEmptyConverter x:Key="FirstNonEmpty"/>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource DarkBarBrush}">

        <!-- TRÁI: hướng cylinder + START/STOP -->
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock x:Name="DirectionDisplay" Foreground="White" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Devices.SystemData.MainDirection}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Down">
                                <Setter Property="Text" Value="↓" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Stop">
                                <Setter Property="Text" Value="" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Up">
                                <Setter Property="Text" Value="↑" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- START/STOP: chỉ dùng được khi ở trang AUTO (ngoài AUTO -> xám) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        IsEnabled="{Binding DataContext.AutoPageVM.AutoPageActive, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Start test (chỉ trang AUTO)"
                        Command="{Binding DataContext.AutoPageVM.ForceStartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.AutoPageVM.State.IsNotTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2E7D32" CornerRadius="5" Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Play" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="START" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#25642A"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Background" Value="#5A6470"/><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Stop test (chỉ trang AUTO)"
                        Command="{Binding DataContext.AutoPageVM.ForceStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.AutoPageVM.State.IsTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D32F2F" CornerRadius="5" Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Stop" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="STOP" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#B12727"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Background" Value="#5A6470"/><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Nhóm giữa: MICOM1 — MICOM2 — danh sách thiết bị, canh giữa -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- ===== MICOM1 ===== -->
            <fa:IconImage Icon="Microchip" Width="12" VerticalAlignment="Center" Margin="2,0">
                <fa:IconImage.Style>
                    <Style TargetType="fa:IconImage">
                        <Setter Property="Foreground" Value="#7F8C9A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </fa:IconImage.Style>
            </fa:IconImage>
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="MICOM1 " VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7F8C9A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Chỉ 1 trong 3 hiện (ưu tiên Data Loss > Verify ✓/✕ > progress), width cố định -->
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                       Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,26,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                        <Binding Path="Devices.MicomData1.VerifyLog"/>
                        <Binding Path="Devices.MicomData1.SignalIntegrity"/>
                        <Binding Path="Devices.MicomData1.FirmwareLog"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- ===== MICOM2 (kế bên MICOM1) ===== -->
            <fa:IconImage Icon="Microchip" Width="12" VerticalAlignment="Center" Margin="2,0">
                <fa:IconImage.Style>
                    <Style TargetType="fa:IconImage">
                        <Setter Property="Foreground" Value="#7F8C9A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </fa:IconImage.Style>
            </fa:IconImage>
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="MICOM2 " VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7F8C9A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                       Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,26,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                        <Binding Path="Devices.MicomData2.VerifyLog"/>
                        <Binding Path="Devices.MicomData2.SignalIntegrity"/>
                        <Binding Path="Devices.MicomData2.FirmwareLog"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- ===== Danh sách thiết bị ===== -->
            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Devices.DevicesStatusVisible}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:DeviceConnectionView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- PHẢI: firmware name -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
            <fa:IconBlock Icon="FileLines" FontSize="13" Foreground="#CFE0F0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Devices.SelectedFirmwareMicom}" Foreground="Orange" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

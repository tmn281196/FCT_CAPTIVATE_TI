<UserControl x:Class="Touch_Panel.View.DeviceConnectionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                            xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View">
    <UserControl.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid   Background="{StaticResource DarkBarBrush}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- START/STOP: chỉ HIỆN khi đang ở trang AUTO; đặt bên TRÁI cụm MICOM -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                        Visibility="{Binding DataContext.AutoPageVM.AutoPageActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Start test"
                        Command="{Binding DataContext.AutoPageVM.ForceStartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.AutoPageVM.State.IsNotTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2E7D32" CornerRadius="5" Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Play" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="START" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#25642A"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Stop test"
                        Command="{Binding DataContext.AutoPageVM.ForceStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.AutoPageVM.State.IsTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D32F2F" CornerRadius="5" Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Stop" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="STOP" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#B12727"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Cụm MICOM1/MICOM2 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Label>
                    <Label.Content>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Microchip" Foreground="White" Width="15" VerticalAlignment="Center" Margin="2 0" />
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"  Text="MICOM1 " VerticalAlignment="Center" />
                            <TextBlock  Foreground="White" FontSize="11" FontWeight="SemiBold"   Text="{Binding Devices.MicomData1.FirmwareLog}" VerticalAlignment="Center"   />
                            <TextBlock  Foreground="White" FontSize="11" FontWeight="SemiBold"   Text="{Binding Devices.MicomData1.SignalIntegrity}" VerticalAlignment="Center" Padding="2 0" />
                        </StackPanel>
                    </Label.Content>
                </Label>
                <Label>
                    <Label.Content>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Microchip" Foreground="White" Width="15" VerticalAlignment="Center" Margin="2 0" />
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"  Text="MICOM2 " VerticalAlignment="Center" />
                            <TextBlock   Foreground="White" FontSize="11" FontWeight="SemiBold"   Text="{Binding  Devices.MicomData2.FirmwareLog}" VerticalAlignment="Center"   />
                            <TextBlock  Foreground="White" FontSize="11" FontWeight="SemiBold"   Text="{Binding Devices.MicomData2.SignalIntegrity}" VerticalAlignment="Center" Padding="2 0" />
                        </StackPanel>
                    </Label.Content>
                </Label>
            </StackPanel>

            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Devices.DevicesStatus}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:DeviceConnectionView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
      
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">


            <Label>
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Foreground="White" Text="MAIN:" Margin="5 0"/>-->



                        <!-- TextBlock hiển thị icon hoặc text tùy theo giá trị -->
                        <TextBlock x:Name="DirectionDisplay" Foreground="White" FontSize="30" FontWeight="Bold" >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Giá trị mặc định (không phải Down) -->
                                    <Setter Property="Text" Value="{Binding Devices.SystemData.MainDirection}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Down">
                                            <Setter Property="Text" Value="↓" />
                                            <!-- hoặc dùng icon font: "" nếu dùng Segoe MDL2 Assets -->
                                            <!-- Nếu muốn icon to hơn: FontSize="20" FontFamily="Segoe MDL2 Assets" -->
                                        </DataTrigger>
                                        
                                        
                                        <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Stop">
                                            <Setter Property="Text" Value="" />
                                            <!-- hoặc dùng icon font: "" nếu dùng Segoe MDL2 Assets -->
                                            <!-- Nếu muốn icon to hơn: FontSize="20" FontFamily="Segoe MDL2 Assets" -->
                                        </DataTrigger>


                                        <!-- Có thể thêm trigger khác nếu cần ví dụ cho "Up" là ↑ -->
                                        <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Up">
                                            <Setter Property="Text" Value="↑" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Label.Content>
            </Label>
        </StackPanel>
        <StackPanel Grid.Column="1"  Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
            <Label>
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                      

                        <TextBlock  Foreground="White"  Text="HEX FILE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"   />
                        <TextBlock Text="{Binding Devices.SelectedFirmwareMicom}" FontSize="11" VerticalAlignment="Center" Foreground="Orange" FontWeight="SemiBold" Margin="5 0"/>


                    </StackPanel>
                </Label.Content>
            </Label>
        </StackPanel>
    </Grid>
</UserControl>

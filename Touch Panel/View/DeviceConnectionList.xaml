<UserControl x:Class="Touch_Panel.View.DeviceConnectionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View">
    <UserControl.Resources>
        <local:FirstNonEmptyConverter x:Key="FirstNonEmpty"/>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Cột khớp AutoPage (sau nav 60px): ELAPSED(1.5*) NEXTSERIAL(1.5*) STATUS(1.5*) STATISTICS(3*) -->
    <Grid Background="{StaticResource DarkBarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Hướng cylinder: double arrow FontAwesome. Mặc định/Stop = đường ngang (Minus). -->
        <fa:IconImage x:Name="DirectionDisplay" Grid.Column="0" Foreground="White" Width="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <fa:IconImage.Style>
                <Style TargetType="fa:IconImage">
                    <Setter Property="Icon" Value="Minus"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Up">
                            <Setter Property="Icon" Value="AnglesUp"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Down">
                            <Setter Property="Icon" Value="AnglesDown"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </fa:IconImage.Style>
        </fa:IconImage>

        <!-- 1) DANH SÁCH THIẾT BỊ: dưới ELAPSED+NEXT SERIAL (cột 1-2), canh giữa -->
        <ItemsControl Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                      ItemsSource="{Binding Devices.DevicesStatusVisible}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DeviceConnectionView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2) START/STOP: canh GIỮA dưới STATUS (cột 3). Ngoài AUTO -> xám. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsEnabled="{Binding DataContext.AutoPageVM.AutoPageActive, RelativeSource={RelativeSource AncestorType=Window}}">
            <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Start test (chỉ trang AUTO)"
                    Command="{Binding DataContext.AutoPageVM.ForceStartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding DataContext.AutoPageVM.State.IsNotTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2E7D32" CornerRadius="5" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconBlock Icon="Play" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="START" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#25642A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Background" Value="#5A6470"/><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Cursor="Hand" Height="30" Focusable="False" VerticalAlignment="Center" ToolTip="Stop test (chỉ trang AUTO)"
                    Command="{Binding DataContext.AutoPageVM.ForceStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding DataContext.AutoPageVM.State.IsTesting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#D32F2F" CornerRadius="5" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconBlock Icon="Stop" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="STOP" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#B12727"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Background" Value="#5A6470"/><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 3) MICOM1 + MICOM2 + FIRMWARE: lưới 3 ô ĐỀU NHAU, lấp đầy đúng cột STATISTICS -->
        <Grid Grid.Column="4" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MICOM1: nền hơi đậm (nhạt hơn MICOM2 một chút) -->
            <Border Grid.Column="0" Background="#283644">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <fa:IconImage Icon="Microchip" Width="12" VerticalAlignment="Center" Margin="2,0">
                        <fa:IconImage.Style>
                            <Style TargetType="fa:IconImage">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconImage.Style>
                    </fa:IconImage>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="MICOM 1 " VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                                <Binding Path="Devices.MicomData1.VerifyLog"/>
                                <Binding Path="Devices.MicomData1.SignalIntegrity"/>
                                <Binding Path="Devices.MicomData1.FirmwareLog"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- MICOM2: nền ĐẬM -->
            <Border Grid.Column="1" Background="#1C2732">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <fa:IconImage Icon="Microchip" Width="12" VerticalAlignment="Center" Margin="2,0">
                        <fa:IconImage.Style>
                            <Style TargetType="fa:IconImage">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconImage.Style>
                    </fa:IconImage>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="MICOM 2 " VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                                <Binding Path="Devices.MicomData2.VerifyLog"/>
                                <Binding Path="Devices.MicomData2.SignalIntegrity"/>
                                <Binding Path="Devices.MicomData2.FirmwareLog"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- FIRMWARE: ô thứ 3. Xám khi chưa có MICOM nào mở, LimeGreen khi có MICOM kết nối. -->
            <Border Grid.Column="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <fa:IconBlock Icon="Memory" FontSize="13" VerticalAlignment="Center">
                        <fa:IconBlock.Style>
                            <Style TargetType="fa:IconBlock">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconBlock.Style>
                    </fa:IconBlock>
                    <TextBlock Text="{Binding Devices.SelectedFirmwareMicom}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7F8C9A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[2].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Devices.DevicesStatus[3].Connected}" Value="True">
                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

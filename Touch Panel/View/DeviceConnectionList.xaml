<UserControl x:Class="Touch_Panel.View.DeviceConnectionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View">
    <UserControl.Resources>
        <local:FirstNonEmptyConverter x:Key="FirstNonEmpty"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource DarkBarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ CỘT 1: hướng + MICOM1 ============ -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Hướng cylinder -->
            <TextBlock x:Name="DirectionDisplay" Foreground="White" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Devices.SystemData.MainDirection}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Down">
                                <Setter Property="Text" Value="↓" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Stop">
                                <Setter Property="Text" Value="" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Devices.SystemData.MainDirection}" Value="Up">
                                <Setter Property="Text" Value="↑" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- MICOM1 -->
            <fa:IconImage Icon="Microchip" Foreground="White" Width="15" VerticalAlignment="Center" Margin="2,0"/>
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="MICOM1 " VerticalAlignment="Center"/>
            <!-- Chỉ 1 trong 3 hiện (ưu tiên Data Loss > Verify ✓/✕ > progress), width cố định -->
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                       Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                        <Binding Path="Devices.MicomData1.VerifyLog"/>
                        <Binding Path="Devices.MicomData1.SignalIntegrity"/>
                        <Binding Path="Devices.MicomData1.FirmwareLog"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <!-- ============ CỘT 2: danh sách thiết bị (rộng nhất) ============ -->
        <ItemsControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding Devices.DevicesStatus}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DeviceConnectionView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============ CỘT 3: MICOM2 ============ -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <fa:IconImage Icon="Microchip" Foreground="White" Width="15" VerticalAlignment="Center" Margin="2,0"/>
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="MICOM2 " VerticalAlignment="Center"/>
            <!-- Chỉ 1 trong 3 hiện (ưu tiên Data Loss > Verify ✓/✕ > progress), width cố định -->
            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                       Width="108" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                        <Binding Path="Devices.MicomData2.VerifyLog"/>
                        <Binding Path="Devices.MicomData2.SignalIntegrity"/>
                        <Binding Path="Devices.MicomData2.FirmwareLog"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

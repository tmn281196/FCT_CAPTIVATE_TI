<UserControl x:Class="Touch_Panel.View.AutoPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

             xmlns:local="clr-namespace:Touch_Panel.View"
             >
    <UserControl.Resources>
        <ResourceDictionary>

            <local:BoolToVisConverter x:Key="BoolToVis"/>

            <Style x:Key="StatusLabelStyle" TargetType="Label">
                <Style.Triggers>



                    <DataTrigger Binding="{Binding Status}" Value="Wait">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="20" />

                        <Setter Property="Background" Value="Orange" />
                        <Setter Property="Content" Value="WAIT" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="20" />

                        <Setter Property="Background" Value="#1B75BB" />
                        <Setter Property="Content" Value="READY" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Testing">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="20" />

                        <Setter Property="Background" Value="#f8da5b" />
                        <Setter Property="Content" Value="TESTING" />

                    </DataTrigger>


                    <DataTrigger Binding="{Binding Status}" Value="Stop">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="20" />

                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Content" Value="STOP" />

                    </DataTrigger>

                </Style.Triggers>
            </Style>

            <Style x:Key="TestResultLabelStyle" TargetType="Label">
                <Style.Triggers>

                    <DataTrigger Binding="{Binding StringTestResult}" Value="BEGIN">
                        <Setter Property="Foreground" Value="Beige" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="LightBlue" />

                        <Setter Property="Content" Value="BEGIN" />


                    </DataTrigger>

                    <DataTrigger Binding="{Binding StringTestResult}" Value="Pass">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="LimeGreen" />
                        <Setter Property="Content" Value="PASS" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding StringTestResult}" Value="Fail">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="Red" />
                        <Setter Property="Content" Value="FAIL" />
                    </DataTrigger>


                </Style.Triggers>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Template.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid >

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.ColumnSpan="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid IsReadOnly="True" SelectedIndex="{Binding TestLogic.Tester1.CurrStep}"  SelectionChanged="DataGrid_SelectionChanged"  ItemsSource="{Binding Model.Micom1TestStep.Steps}" Background="White" Style="{StaticResource CustomDataGridStyle}" Grid.Column="0"
    ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding No}" Width="50" Header="No" />
                    <DataGridTextColumn Binding="{Binding Test}" Width="*"  Header="CMD Name" />
                    <DataGridTextColumn Binding="{Binding Objectid}" Width="*"  Header="Object ID" />
                    <DataGridTextColumn Binding="{Binding Specvalue}" Width="*"  Header="Spec Value" />
                    <DataGridTextColumn Binding="{Binding Value}" Width="100"  Header="Value" />
                    <DataGridTextColumn Binding="{Binding TaktTime}" Width="100"  Header="Takt Time" />
                    <DataGridTemplateColumn Width="80" Header="Result">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fa:IconBlock Width="20" Height="20" FontSize="18"  VerticalAlignment="Center"  HorizontalAlignment="Center">
                                    <fa:IconBlock.Style>
                                        <Style TargetType="fa:IconBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Icon" Value="Circle"/>

                                            <Style.Triggers>
                                                <!-- SKIP -->
                                                <DataTrigger Binding="{Binding Result}" Value="Skip">
                                                    <Setter Property="Icon" Value="CircleChevronRight"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>

                                                <!-- PASS -->
                                                <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                    <Setter Property="Icon" Value="CircleCheck"/>
                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>

                                                <!-- FAIL -->
                                                <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                    <Setter Property="Icon" Value="CircleXmark"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:IconBlock.Style>
                                </fa:IconBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid IsReadOnly="True" SelectedIndex="{Binding TestLogic.Tester2.CurrStep}"  SelectionChanged="DataGrid_SelectionChanged"  ItemsSource="{Binding Model.Micom2TestStep.Steps}" Background="White" Style="{StaticResource CustomDataGridStyle}" Grid.Column="1"
    ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding No}" Width="50" Header="No" />
                    <DataGridTextColumn Binding="{Binding Test}" Width="*"  Header="CMD Name" />
                    <DataGridTextColumn Binding="{Binding Objectid}" Width="*"  Header="Object ID" />
                    <DataGridTextColumn Binding="{Binding Specvalue}" Width="*"  Header="Spec Value" />
                    <DataGridTextColumn Binding="{Binding Value}" Width="100"  Header="Value" />
                    <DataGridTextColumn Binding="{Binding TaktTime}" Width="100"  Header="Takt Time" />

                    <DataGridTemplateColumn Width="80" Header="Result">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <fa:IconBlock Width="20" Height="20" FontSize="18"  VerticalAlignment="Center"  HorizontalAlignment="Center">
                                    <fa:IconBlock.Style>
                                        <Style TargetType="fa:IconBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Icon" Value="Circle"/>

                                            <Style.Triggers>
                                                <!-- SKIP -->
                                                <DataTrigger Binding="{Binding Result}" Value="Skip">
                                                    <Setter Property="Icon" Value="CircleChevronRight"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>

                                                <!-- PASS -->
                                                <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                    <Setter Property="Icon" Value="CircleCheck"/>
                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                </DataTrigger>

                                                <!-- FAIL -->
                                                <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                    <Setter Property="Icon" Value="CircleXmark"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:IconBlock.Style>
                                </fa:IconBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>





        <Grid Grid.Row="1" Grid.Column="2" Margin="0.5,0,0,0" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
           Content="STATISTICS"
           FontWeight="SemiBold"
           HorizontalContentAlignment="Center"
           Foreground="White"
           Background="{StaticResource BaseBrush}" />

            <UniformGrid Rows="1" Columns="4" Grid.Row="1">

                <!-- Card thống kê: bo góc, nền pastel, KHÔNG border, giãn đều lấp đầy -->
                <Border Margin="0" CornerRadius="0" Background="#EEF1F4">
                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="TOTAL" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#44505C"/>
                        <TextBlock Text="{Binding Total}" HorizontalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="#1B2A38"/>
                    </StackPanel>
                </Border>

                <Border Margin="0" CornerRadius="0" Background="#E7F6E9">
                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="PASS" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                        <TextBlock Text="{Binding Pass}" HorizontalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <Border Margin="0" CornerRadius="0" Background="#FCEAEA">
                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="NG" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#C0392B"/>
                        <TextBlock Text="{Binding Fail}" HorizontalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="#C0392B"/>
                    </StackPanel>
                </Border>

                <Border Margin="0" CornerRadius="0" Background="#FFF6E5">
                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="PASS %" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#B8860B"/>
                        <TextBlock Text="{Binding PassPercent}" HorizontalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="#B8860B"/>
                    </StackPanel>
                </Border>

            </UniformGrid>


        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0.5,0,0.5,0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>
            <Label HorizontalContentAlignment="Center" Content="STATUS" FontWeight="SemiBold" Foreground="White" Background="{StaticResource BaseBrush}" />
            <Label Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Style="{StaticResource StatusLabelStyle}" />
            <Label Grid.Row="2"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Style="{StaticResource TestResultLabelStyle}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0"  Margin="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,0.5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Label HorizontalContentAlignment="Center" Content="ELAPSED TIME" FontWeight="SemiBold" Foreground="White" Background="{StaticResource BaseBrush}" />
                <Label Grid.Row="1" Content="{Binding ElapsedTime}" FontWeight="Bold" FontSize="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  x:Name="elapsedTimeLbl"  Background="White"  />

            </Grid>

            <Grid Grid.Column="1" Margin="0.5,0,0.5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Label HorizontalContentAlignment="Center" Content="NEXT SERIAL" FontWeight="SemiBold" Foreground="White" Background="{StaticResource BaseBrush}" />
                <Label Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White">
                    <TextBlock Text="{Binding NextSerialNumber, StringFormat=D4}" FontWeight="Bold" FontSize="48" Foreground="#E67E22"/>
                </Label>

            </Grid>

        </Grid>

    </Grid>

</UserControl>

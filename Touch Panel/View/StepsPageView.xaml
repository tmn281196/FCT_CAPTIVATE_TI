<UserControl x:Class="Touch_Panel.View.StepsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:Touch_Panel.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            >
    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="StatusLabelStyle" TargetType="Label">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Wait">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="Orange" />
                        <Setter Property="Content" Value="WAIT" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="#347474" />
                        <Setter Property="Content" Value="READY" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Testing">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="#f8da5b" />
                        <Setter Property="Content" Value="TESTING" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Pass">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />

                        <Setter Property="Background" Value="LimeGreen" />
                        <Setter Property="Content" Value="PASS" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="30" />
                        <Setter Property="Background" Value="Red" />
                        <Setter Property="Content" Value="FAIL" />

                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Ô nhập bo góc, sáng viền xanh khi focus -->
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#C3D3EE"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox bo góc đồng bộ -->
            <Style x:Key="FieldCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1B2A38"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#C3D3EE" BorderThickness="1" CornerRadius="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1B75BB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#44505C"/>
                                <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                        <Border Background="White" BorderBrush="#C3D3EE" BorderThickness="1" CornerRadius="4"/>
                                        <ScrollViewer Margin="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Template.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid  HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,4,0,14" IsEnabled="{Binding AutoState.IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Command="{Binding AddStepCommand}"  CommandParameter="1" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Add" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteStepCommand}"  CommandParameter="1" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Trash" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DuplicateStepCommand}"  CommandParameter="1" ToolTip="Duplicate Step" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Copy" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveStepUpCommand}"  CommandParameter="1" ToolTip="Move Up" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="ArrowUp" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveStepDownCommand}"  CommandParameter="1" ToolTip="Move Down" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="ArrowDown" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SkipAllStepsCommand}"  CommandParameter="1" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Square" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding UnSkipAllStepsCommand}"  CommandParameter="1" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="CheckSquare" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
           
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <StackPanel Margin="4 0" >
                        <Label Content="CMD Name" FontSize="11" Padding="1" HorizontalContentAlignment="Center" Foreground="#44505C"/>
                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding TestList}" SelectedItem="{Binding TestSelItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="123"/>
                    </StackPanel>
                    <StackPanel Margin="4 0" >
                        <Label Content="Time Delay (ms)" FontSize="11" Padding="1" HorizontalContentAlignment="Center" Foreground="#44505C"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="102" Text="{Binding TimeDelayInput, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="4 0" >
                        <Label Content="Time Test (ms)" FontSize="11" Padding="1" HorizontalContentAlignment="Center" Foreground="#44505C"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="102" Text="{Binding TimeTestInput, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="4 0" >
                        <Label Content="Object ID" FontSize="11" Padding="1" HorizontalContentAlignment="Center" Foreground="#44505C"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="102" Text="{Binding ObjectIdInput, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Margin="4 0" >
                        <Label Content="Spec Value" FontSize="11" Padding="1" HorizontalContentAlignment="Center" Foreground="#44505C"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="102" Text="{Binding SpecValueInput, Mode=TwoWay}"/>
                    </StackPanel>

                </StackPanel>

               
               
            </StackPanel>


            



            <!-- Mirror của nhóm bảng 1: thứ tự đảo lại để hai thanh nút đối xứng qua tâm -->
            <StackPanel   Orientation="Horizontal" Grid.Column="2"  HorizontalAlignment="Right">
                <Button Command="{Binding UnSkipAllStepsCommand}"  CommandParameter="2" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="CheckSquare" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SkipAllStepsCommand}"  CommandParameter="2" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Square" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveStepDownCommand}"  CommandParameter="2" ToolTip="Move Down" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="ArrowDown" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveStepUpCommand}"  CommandParameter="2" ToolTip="Move Up" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="ArrowUp" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DuplicateStepCommand}"  CommandParameter="2" ToolTip="Duplicate Step" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Copy" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteStepCommand}"  CommandParameter="2" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Trash" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddStepCommand}"  CommandParameter="2" BorderThickness="0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Right" Margin="3,1">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Add" Foreground="Gray" Width="18"/>
                    </StackPanel>
                </Button>
            </StackPanel>



            <!-- Nút Save / Save As đã gom lên thanh top -->




        </Grid>




        <DataGrid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" VerticalScrollBarVisibility="Visible" IsReadOnly="{Binding AutoState.IsBusy}"  ItemsSource="{Binding Model.Micom1TestStep.Steps, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding StepSelIdx1}" SelectedItem="{Binding StepSelItem1}" Background="White" Style="{StaticResource CustomDataGridStyle}"
  ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding No}" Width="50" Header="No" />
                    <DataGridTextColumn Binding="{Binding Test}" Width="*" Header="CMD Name" />
                    <DataGridTextColumn Binding="{Binding Timedelay}" Width="*" Header="Time Delay" />
                    <DataGridTextColumn Binding="{Binding Timetest}" Width="*" Header="Time Test" />

                    <DataGridTextColumn Binding="{Binding Objectid}" Width="*" Header="Object ID" />
                    <DataGridTextColumn Binding="{Binding Specvalue}" Width="*" Header="Spec Value" />

                    <DataGridCheckBoxColumn Header="Enable" Binding="{Binding NoSkip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="*" />
                </DataGrid.Columns>


            </DataGrid>

        <DataGrid Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" VerticalScrollBarVisibility="Visible" IsReadOnly="{Binding AutoState.IsBusy}"  ItemsSource="{Binding Model.Micom2TestStep.Steps, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding StepSelIdx2}" SelectedItem="{Binding StepSelItem2}" Background="White" Style="{StaticResource CustomDataGridStyle}"
ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding No, UpdateSourceTrigger=PropertyChanged}" Width="50" Header="No" />
                    <DataGridTextColumn Binding="{Binding Test, UpdateSourceTrigger=PropertyChanged}" Width="*"  Header="CMD Name" />
                    <DataGridTextColumn Binding="{Binding Timedelay, UpdateSourceTrigger=PropertyChanged}" Width="*"  Header="Time Delay" />
                    <DataGridTextColumn Binding="{Binding Timetest, UpdateSourceTrigger=PropertyChanged}" Width="*"  Header="Time Test" />

                    <DataGridTextColumn Binding="{Binding Objectid, UpdateSourceTrigger=PropertyChanged}" Width="*"  Header="Object ID" />
                    <DataGridTextColumn Binding="{Binding Specvalue, UpdateSourceTrigger=PropertyChanged}" Width="*"  Header="Spec Value" />
                    <DataGridCheckBoxColumn Header="Enable" Binding="{Binding NoSkip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="*" />
                </DataGrid.Columns>



            </DataGrid>
    </Grid>
</UserControl>

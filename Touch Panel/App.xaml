<Application x:Class="Touch_Panel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Touch_Panel">
    <Application.Resources>
        <Color x:Key="Base">#323F4E</Color>
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
        <!-- Thanh top/bottom: cùng tông nhưng đậm hơn -->
        <SolidColorBrush x:Key="DarkBarBrush" Color="#24303B"/>
    </Application.Resources>
</Application>
